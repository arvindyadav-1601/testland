  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "xlsx": "^0.18.5"
  },
  "scripts": {

  "clean": "rm -rf allure-results allure-report playwright-report test-results",
  "setup": "npm install && npx playwright install",
  "install:browsers": "playwright install",
  "test": "npm run clean && playwright test",
  "test:chrome": "npm run clean && playwright test --project=chromium",
  "test:headed": "npm run clean && playwright test --headed",
  "test:debug": "npm run clean && playwright test --debug",
  "report": "playwright show-report",
  "allure:gen": "allure generate allure-results --clean -o allure-report",
  "allure:open": "allure open allure-report",
  "allure": "allure serve allure-results"
}
}
