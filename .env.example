QA1_PASSWORD=

QA2_URL=https://dev-qa2-cp.test.landnav.com/
QA2_USERNAME=
QA2_PASSWORD=

DEV_URL=https://dev-cicd1-cp.test.landnav.com/
DEV_USERNAME=
DEV_PASSWORD=

