{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "paths": {
      "@pages/*":  ["pages/*"],
      "@utils/*":  ["utils/*"],
      "@config/*": ["config/*"],
      "@testdata/*": ["testdata/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}

